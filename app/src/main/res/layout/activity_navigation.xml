<?xml version="1.0" encoding="utf-8"?>
<!-- Navigation (beta): the Google map full screen; over it, top left the search bar (or the
     next-turn banner while guiding), bottom left the trip card, bottom right re-centre and voice. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sunken">

    <FrameLayout
        android:id="@+id/nav_map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/nav_no_map"
        android:layout_width="560dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:text="@string/nav_no_map"
        android:textAppearance="@style/TextAppearance.Cam.Body"
        android:textColor="@color/text_secondary"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="520dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:orientation="vertical">

        <!-- search bar: back, the box, BETA -->
        <LinearLayout
            android:id="@+id/nav_search_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/title_bar_height"
            android:background="@drawable/bg_nav_pill"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="14dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/nav_close"
                style="@style/Widget.Cam.IconButton"
                android:layout_width="@dimen/icon_button_size"
                android:layout_height="@dimen/icon_button_size"
                android:contentDescription="@string/action_back"
                app:backgroundTint="@android:color/transparent"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_back" />
            <EditText
                android:id="@+id/nav_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/nav_search_hint"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:singleLine="true"
                android:textAppearance="@style/TextAppearance.Cam.Row"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_segment"
                android:paddingStart="10dp"
                android:paddingTop="2dp"
                android:paddingEnd="10dp"
                android:paddingBottom="2dp"
                android:text="@string/nav_beta"
                android:textAppearance="@style/TextAppearance.Cam.Caption"
                android:textColor="@color/energy_text"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- search results and the place shared from the iPhone -->
        <LinearLayout
            android:id="@+id/nav_results"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_nav_card"
            android:elevation="6dp"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:visibility="gone" />

        <!-- next turn while guiding -->
        <LinearLayout
            android:id="@+id/nav_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_nav_banner"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:minHeight="128dp"
            android:orientation="horizontal"
            android:padding="18dp"
            android:visibility="gone">
            <view
                class="com.kooo.evcam.nav.ManeuverIcon$ArrowView"
                android:id="@+id/nav_arrow"
                android:layout_width="84dp"
                android:layout_height="84dp" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/nav_to_next"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Cam.Display"
                    android:textColor="@color/white"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/nav_instruction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textAppearance="@style/TextAppearance.Cam.Title"
                    android:textColor="@color/white" />
                <TextView
                    android:id="@+id/nav_instruction_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Cam.Body"
                    android:textColor="#D9FFFFFF"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- the HUD preview over the map: the card the HUD shows now, or a sample when nothing is guided -->
    <LinearLayout
        android:id="@+id/nav_hud_preview"
        android:layout_width="440dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="100dp"
        android:layout_marginEnd="16dp"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView
            android:id="@+id/nav_hud_preview_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_segment"
            android:paddingStart="10dp"
            android:paddingTop="2dp"
            android:paddingEnd="10dp"
            android:paddingBottom="2dp"
            android:textAppearance="@style/TextAppearance.Cam.Caption"
            android:textColor="@color/text_primary" />
        <FrameLayout
            android:id="@+id/nav_hud_preview_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <!-- the trip: where to, how long, battery at arrival, Start / End -->
    <LinearLayout
        android:id="@+id/nav_sheet"
        android:layout_width="520dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="16dp"
        android:background="@drawable/bg_nav_card"
        android:elevation="6dp"
        android:orientation="vertical"
        android:padding="22dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <!-- while guiding: end the trip, beside the time -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/nav_end_guiding"
                style="@style/Widget.Cam.IconButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginEnd="18dp"
                android:contentDescription="@string/nav_end"
                android:visibility="gone"
                app:cornerRadius="32dp"
                app:icon="@drawable/ic_close"
                app:iconSize="30dp" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/nav_place"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Cam.Title"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/nav_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance.Cam.Row"
                    android:textColor="@color/nav_time"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/nav_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance.Cam.Body"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/nav_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">
            <!-- everything else (HUD, map and car colours, iPhone) is in the settings dialog -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/nav_settings"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:text="@string/nav_settings_button"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_settings" />
            <!-- with a route shown: keep its place for search and Automation -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/nav_save_place"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginStart="10dp"
                android:text="@string/place_save"
                android:visibility="gone"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_automation_place" />
        </LinearLayout>
        <!-- before starting: the routes to choose from, Google's pick first; filled in by NavigationActivity -->
        <LinearLayout
            android:id="@+id/nav_routes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="gone" />
        <LinearLayout
            android:id="@+id/nav_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/nav_go"
                style="@style/Widget.Cam.RailSmall"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:minWidth="180dp"
                android:text="@string/nav_start"
                android:textColor="@color/white"
                app:backgroundTint="@color/nav_blue"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_navigation"
                app:iconTint="@color/white" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/nav_end"
                style="@style/Widget.Cam.RailSmall"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                android:minWidth="120dp"
                android:text="@string/nav_end"
                app:cornerRadius="28dp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:orientation="vertical">
        <!-- zoom: while guiding they move the map's own zoom closer or further (kept); otherwise a plain zoom -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/nav_zoom_in"
            style="@style/Widget.Cam.IconButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="end"
            android:layout_marginBottom="8dp"
            android:contentDescription="@string/nav_zoom_in"
            android:elevation="6dp"
            android:stateListAnimator="@null"
            app:backgroundTint="@color/surface"
            app:cornerRadius="36dp"
            app:icon="@drawable/ic_zoom_in"
            app:iconSize="30dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/nav_zoom_out"
            style="@style/Widget.Cam.IconButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="end"
            android:layout_marginBottom="24dp"
            android:contentDescription="@string/nav_zoom_out"
            android:elevation="6dp"
            android:stateListAnimator="@null"
            app:backgroundTint="@color/surface"
            app:cornerRadius="36dp"
            app:icon="@drawable/ic_zoom_out"
            app:iconSize="30dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/nav_float"
            style="@style/Widget.Cam.IconButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="end"
            android:layout_marginBottom="12dp"
            android:contentDescription="@string/nav_float"
            android:elevation="6dp"
            android:stateListAnimator="@null"
            app:backgroundTint="@color/surface"
            app:cornerRadius="36dp"
            app:icon="@drawable/ic_float_window"
            app:iconSize="30dp" />
        <!-- the map was moved by hand: back to the car -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/nav_recenter"
            style="@style/Widget.Cam.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:layout_gravity="end"
            android:layout_marginTop="12dp"
            android:elevation="6dp"
            android:paddingLeft="20dp"
            android:paddingRight="24dp"
            android:stateListAnimator="@null"
            android:text="@string/nav_recenter"
            android:textAppearance="@style/TextAppearance.Cam.Body"
            android:textColor="@color/nav_blue_text"
            android:visibility="gone"
            app:backgroundTint="@color/surface"
            app:cornerRadius="32dp"
            app:icon="@drawable/ic_navigation"
            app:iconPadding="8dp"
            app:iconTint="@color/nav_blue_text" />
    </LinearLayout>
</FrameLayout>
