<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="16dp">
    <!--
  7xDash：和主页一个样子 —— 页边 16dp，标题下面不画分隔线，内容放在一张大圆角卡片上（bg_surface_card）。
-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/title_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="16dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/shortcut_capture_close"
            style="@style/Widget.Cam.IconButton"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:contentDescription="@string/action_back"
            app:icon="@drawable/ic_back" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="@string/shortcut_add"
            android:textAppearance="@style/TextAppearance.Cam.Title"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_surface_card"
        android:orientation="vertical"
        android:padding="12dp">
        <TextView
            android:id="@+id/shortcut_prompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp"
            android:text="@string/shortcut_press"
            android:textAppearance="@style/TextAppearance.Cam.Title"
            android:textColor="@color/text_primary" />
        <TextView
            android:id="@+id/shortcut_press_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingBottom="6dp"
            android:text="@string/shortcut_step_press"
            android:textAppearance="@style/TextAppearance.Cam.Caption"
            android:textColor="@color/text_secondary" android:visibility="gone" />
        <LinearLayout
            android:id="@+id/shortcut_press_kinds"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:visibility="gone">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/shortcut_press_tap"
                style="@style/Widget.Cam.RailSmall"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/shortcut_press_tap" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/shortcut_press_long"
                style="@style/Widget.Cam.RailSmall"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/shortcut_press_long" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/shortcut_press_double"
                style="@style/Widget.Cam.RailSmall"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="@string/shortcut_press_double" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/shortcut_actions"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView
                android:id="@+id/shortcut_action_caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingBottom="6dp"
                android:text="@string/shortcut_step_action"
                android:textAppearance="@style/TextAppearance.Cam.Caption"
                android:textColor="@color/text_secondary" />
            <LinearLayout
                android:id="@+id/shortcut_action_tabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:fadeScrollbars="false"
                android:paddingBottom="24dp"
                android:scrollbars="vertical">
                <LinearLayout
                    android:id="@+id/shortcut_action_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp" />
            </ScrollView>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
