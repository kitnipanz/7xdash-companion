<?xml version="1.0" encoding="utf-8"?>
<!-- One gear's (or speed's) look: color, brightness, effect. Built up in MoodLightActivity#editLook. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp">
        <LinearLayout
            android:id="@+id/look_from_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/mood_light_band_from"
                android:textAppearance="@style/TextAppearance.Cam.Body"
                android:textColor="@color/text_primary" />
            <EditText
                android:id="@+id/look_from"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="3"
                android:textColor="@color/text_primary"
                android:hint="@string/mood_light_band_from" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <com.kooo.evcam.light.EffectSwatchView
                android:id="@+id/look_preview"
                android:layout_width="0dp"
                android:layout_height="24dp"
                android:layout_weight="1"
                android:layout_marginEnd="16dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/look_effect"
                style="@style/Widget.Cam.RailSmall"
                android:layout_width="wrap_content"
                android:layout_height="52dp" />
        </LinearLayout>
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/look_swatches"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/mood_light_hue"
            android:textAppearance="@style/TextAppearance.Cam.Body"
            android:textColor="@color/text_primary" />
        <SeekBar
            android:id="@+id/look_hue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="359" />
        <TextView
            android:id="@+id/look_brightness_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textAppearance="@style/TextAppearance.Cam.Body"
            android:textColor="@color/text_primary" />
        <SeekBar
            android:id="@+id/look_brightness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="100" />
        <TextView
            android:id="@+id/look_speed_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textAppearance="@style/TextAppearance.Cam.Body"
            android:textColor="@color/text_primary" />
        <SeekBar
            android:id="@+id/look_speed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="100" />
        <TextView
            android:id="@+id/look_basic_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/mood_light_effect_basic"
            android:textAppearance="@style/TextAppearance.Cam.Caption"
            android:textColor="@color/text_tertiary" />
    </LinearLayout>
</ScrollView>
