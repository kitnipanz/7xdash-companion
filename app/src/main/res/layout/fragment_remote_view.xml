<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="16dp">
    <!--
  7xDash：和主页一个样子 —— 页边 16dp，标题下面不画分隔线，内容放在一张大圆角卡片上（bg_surface_card）。
-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/title_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="16dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_remote_back"
            style="@style/Widget.Cam.IconButton"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:contentDescription="@string/action_back"
            app:icon="@drawable/ic_back" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="@string/remote_title"
            android:textAppearance="@style/TextAppearance.Cam.Title"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_surface_card"
        android:orientation="vertical"
        android:padding="12dp">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="32dp">
                <TextView
                    android:id="@+id/remote_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="@string/remote_offline"
                    android:textAppearance="@style/TextAppearance.Cam.Caption"
                    android:textColor="@color/text_secondary" />
                <TextView
                    android:id="@+id/remote_email"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance.Cam.Micro"
                    android:textColor="@color/text_tertiary" />
                <ImageView
                    android:id="@+id/remote_qr"
                    android:layout_width="280dp"
                    android:layout_height="280dp"
                    android:layout_marginTop="24dp"
                    android:contentDescription="@string/remote_title"
                    android:scaleType="fitCenter" />
                <TextView
                    android:id="@+id/remote_url"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="monospace"
                    android:textAppearance="@style/TextAppearance.Cam.Micro"
                    android:textColor="@color/text_secondary" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_remote_refresh_code"
                    style="@style/Widget.Cam.RailSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/remote_refresh_code"
                    android:visibility="gone" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:text="@string/remote_hint"
                    android:textAppearance="@style/TextAppearance.Cam.Caption"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
