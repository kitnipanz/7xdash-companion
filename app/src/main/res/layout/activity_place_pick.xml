<?xml version="1.0" encoding="utf-8"?>
<!-- Pick a place on the map: move the map until the pin sits on it, then save it. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sunken">

    <FrameLayout
        android:id="@+id/pick_map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/pick_no_map"
        android:layout_width="560dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:text="@string/place_pick_no_map"
        android:textAppearance="@style/TextAppearance.Cam.Body"
        android:textColor="@color/text_secondary"
        android:visibility="gone" />

    <!-- the pin's tip is the map's centre -->
    <ImageView
        android:id="@+id/pick_pin"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:layout_marginBottom="48dp"
        android:contentDescription="@null"
        android:elevation="8dp"
        android:src="@drawable/ic_map_pin" />

    <LinearLayout
        android:layout_width="520dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/title_bar_height"
            android:background="@drawable/bg_nav_pill"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="20dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/pick_close"
                style="@style/Widget.Cam.IconButton"
                android:layout_width="@dimen/icon_button_size"
                android:layout_height="@dimen/icon_button_size"
                android:contentDescription="@string/action_back"
                app:backgroundTint="@android:color/transparent"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_back" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/place_pick_title"
                android:textAppearance="@style/TextAppearance.Cam.Title"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="520dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="16dp"
        android:background="@drawable/bg_nav_pill"
        android:elevation="6dp"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/place_pick_hint"
            android:textAppearance="@style/TextAppearance.Cam.Body"
            android:textColor="@color/text_primary" />
        <TextView
            android:id="@+id/pick_where"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textAppearance="@style/TextAppearance.Cam.Caption"
            android:textColor="@color/text_secondary" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/pick_here"
                style="@style/Widget.Cam.RailSmall"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:text="@string/place_pick_my_spot"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_recenter" />
            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/pick_save"
                style="@style/Widget.Cam.RailSmall"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:minWidth="180dp"
                android:text="@string/place_pick_save"
                android:textColor="@color/white"
                app:backgroundTint="@color/nav_blue"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_add"
                app:iconTint="@color/white" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
