<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_pref_row"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="64dp"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/speaker_probe_facts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="@style/TextAppearance.Cam.Body"
        android:textColor="@color/pref_title" />

    <TextView
        android:id="@+id/speaker_probe_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="@style/TextAppearance.Cam.Micro"
        android:textColor="@color/text_tertiary" />

    <TextView
        android:id="@+id/speaker_probe_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="@style/TextAppearance.Cam.Micro"
        android:textColor="@color/text_primary"
        android:visibility="gone" />

    <TextView
        android:id="@+id/speaker_probe_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="@style/TextAppearance.Cam.Micro"
        android:textColor="@color/text_tertiary"
        android:visibility="gone" />
</LinearLayout>
