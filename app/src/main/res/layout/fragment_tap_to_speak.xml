<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tap_speak_button"
            android:textAppearance="@style/TextAppearance.Cam.Micro"
            android:textColor="@color/pref_summary" />

        <TextView
            android:id="@+id/tap_speak_button_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.Cam.Body"
            android:textColor="@color/pref_title" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tap_speak_button_set"
            style="@style/Widget.Cam.RailSmall"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:text="@string/tap_speak_button_set" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tap_speak_mode"
            android:textAppearance="@style/TextAppearance.Cam.Micro"
            android:textColor="@color/pref_summary" />

        <TextView
            android:id="@+id/tap_speak_hold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_pref_row"
            android:paddingStart="20dp"
            android:paddingTop="14dp"
            android:paddingEnd="20dp"
            android:paddingBottom="14dp"
            android:text="@string/tap_speak_hold"
            android:textAppearance="@style/TextAppearance.Cam.Body"
            android:textColor="@color/pref_title" />

        <TextView
            android:id="@+id/tap_speak_once"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_pref_row"
            android:paddingStart="20dp"
            android:paddingTop="14dp"
            android:paddingEnd="20dp"
            android:paddingBottom="14dp"
            android:text="@string/tap_speak_once"
            android:textAppearance="@style/TextAppearance.Cam.Body"
            android:textColor="@color/pref_title" />

        <LinearLayout
            android:id="@+id/tap_speak_seconds"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/tap_speak_volume"
            android:textAppearance="@style/TextAppearance.Cam.Micro"
            android:textColor="@color/pref_summary" />

        <TextView
            android:id="@+id/tap_speak_volume_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.Cam.Body"
            android:textColor="@color/pref_title" />

        <SeekBar
            android:id="@+id/tap_speak_volume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:max="100" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tap_speak_speaker"
            android:textAppearance="@style/TextAppearance.Cam.Micro"
            android:textColor="@color/pref_summary" />

        <LinearLayout
            android:id="@+id/tap_speak_speakers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
