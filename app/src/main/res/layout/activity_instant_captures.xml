<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="16dp">
    <!--
  7xDash：和主页一个样子 —— 页边 16dp，标题下面不画分隔线，内容放在一张大圆角卡片上（bg_surface_card）。
-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/title_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="16dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/instant_close"
            style="@style/Widget.Cam.IconButton"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:contentDescription="@string/action_back"
            app:icon="@drawable/ic_back" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="@string/instant_captures_title"
            android:textAppearance="@style/TextAppearance.Cam.Title"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/instant_delete_all"
            style="@style/Widget.Cam.IconButton"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:contentDescription="@string/instant_captures_delete_all"
            app:icon="@drawable/ic_delete" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_surface_card"
        android:orientation="vertical"
        android:padding="12dp">
        <TextView
            android:id="@+id/instant_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/instant_captures_empty"
            android:textAppearance="@style/TextAppearance.Cam.Body"
            android:textColor="@color/text_secondary"
            android:visibility="gone" />
        <LinearLayout
            android:id="@+id/instant_body"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <ScrollView
                android:layout_width="@dimen/list_width"
                android:layout_height="match_parent"
                android:fillViewport="true">
                <LinearLayout
                    android:id="@+id/instant_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp" />
            </ScrollView>
            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/line" />
            <FrameLayout
                android:id="@+id/instant_stage"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/black">
                <VideoView
                    android:id="@+id/instant_player"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/bg_status_scrim" />
                <TextView
                    android:id="@+id/instant_now"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:fontFeatureSettings="tnum"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="16dp"
                    android:textAppearance="@style/TextAppearance.Cam.Title"
                    android:textColor="@color/status_overlay_text" />
                <ImageView
                    android:id="@+id/instant_play"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_play"
                    android:visibility="gone" />
                <View
                    android:id="@+id/instant_touch"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
