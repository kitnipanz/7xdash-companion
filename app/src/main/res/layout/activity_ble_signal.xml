<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="16dp">
    <!--
  7xDash：和主页一个样子 —— 页边 16dp，标题下面不画分隔线，内容放在一张大圆角卡片上（bg_surface_card）。
-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/title_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="16dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/ble_close"
            style="@style/Widget.Cam.IconButton"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:contentDescription="@string/action_back"
            app:icon="@drawable/ic_back" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="@string/ble_signal_title"
            android:textAppearance="@style/TextAppearance.Cam.Title"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/ble_scan"
            style="@style/Widget.Cam.RailSmall"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:text="@string/sticker_scan" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_surface_card"
        android:orientation="vertical"
        android:padding="12dp">
        <TextView
            android:id="@+id/ble_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:text="@string/ble_signal_empty"
            android:textAppearance="@style/TextAppearance.Cam.Caption"
            android:textColor="@color/text_secondary" />
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">
            <LinearLayout
                android:id="@+id/ble_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp" />
        </ScrollView>
    </LinearLayout>
</LinearLayout>
