<?xml version="1.0" encoding="utf-8"?>
<!-- 列表里的一行：和设置行一样是一块圆角灰卡（7xDash 统一样式） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_pref_row_static"
    android:minHeight="72dp"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/shortcut_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.Cam.Body"
        android:textColor="@color/text_primary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/shortcut_delete"
        style="@style/Widget.Cam.RailSmall"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:text="@string/action_delete" />
</LinearLayout>
