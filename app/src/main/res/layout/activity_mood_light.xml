<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="16dp">
    <!--
  Mood light: same frame as the sticker screen. Left card is the light (on/off, color,
  brightness), right card is the scan list.
-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/title_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="16dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/light_close"
            style="@style/Widget.Cam.IconButton"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:contentDescription="@string/action_back"
            app:icon="@drawable/ic_back" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="@string/set_mood_light_title"
            android:textAppearance="@style/TextAppearance.Cam.Title"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/mood_light_subtitle"
            android:textAppearance="@style/TextAppearance.Cam.Caption"
            android:textColor="@color/text_tertiary" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/light_scan"
            style="@style/Widget.Cam.RailSmall"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:text="@string/sticker_scan" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:baselineAligned="false"
        android:orientation="horizontal">
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_surface_card"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">
                <!--
  Groups: a tab per group (the open one filled) and New; under them the open group's own card,
  so Rename and Delete sit next to the name they act on.
-->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="@string/mood_light_groups_title"
                    android:textAppearance="@style/TextAppearance.Cam.Caption"
                    android:textColor="@color/text_tertiary" />
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:scrollbars="none">
                    <LinearLayout
                        android:id="@+id/light_groups"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_pref_row_static"
                    android:gravity="center_vertical"
                    android:minHeight="72dp"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="10dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/light_group_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.Cam.Title"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/light_group_summary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Cam.Caption"
                            android:textColor="@color/text_secondary" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/light_group_rename"
                        style="@style/Widget.Cam.IconButton"
                        android:layout_width="@dimen/icon_button_size"
                        android:layout_height="@dimen/icon_button_size"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="@string/mood_light_group_rename"
                        app:icon="@drawable/ic_edit" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/light_group_delete"
                        style="@style/Widget.Cam.IconButton"
                        android:layout_width="@dimen/icon_button_size"
                        android:layout_height="@dimen/icon_button_size"
                        android:contentDescription="@string/mood_light_group_delete"
                        app:icon="@drawable/ic_delete" />
                </LinearLayout>
                <TextView
                    android:id="@+id/light_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/mood_light_pick"
                    android:textAppearance="@style/TextAppearance.Cam.Body"
                    android:textColor="@color/text_secondary" />
                <LinearLayout
                    android:id="@+id/light_controls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <View
                            android:id="@+id/light_preview"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:layout_marginEnd="16dp"
                            android:background="@drawable/sticker_dot" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/light_on"
                            style="@style/Widget.Cam.RailSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="52dp"
                            android:layout_marginEnd="8dp"
                            android:text="@string/mood_light_on" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/light_off"
                            style="@style/Widget.Cam.RailSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="52dp"
                            android:text="@string/mood_light_off" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/light_swatches"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/mood_light_hue"
                        android:textAppearance="@style/TextAppearance.Cam.Body"
                        android:textColor="@color/text_primary" />
                    <SeekBar
                        android:id="@+id/light_hue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:max="359" />
                    <TextView
                        android:id="@+id/light_brightness_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:textAppearance="@style/TextAppearance.Cam.Body"
                        android:textColor="@color/text_primary" />
                    <SeekBar
                        android:id="@+id/light_brightness"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:max="100" />
                </LinearLayout>
                <!-- Gear rules: editable without the light, saved and run by GearLight -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/light_gear_switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/mood_light_gear_title"
                    android:textAppearance="@style/TextAppearance.Cam.Body"
                    android:textColor="@color/text_primary" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/mood_light_gear_hint"
                    android:textAppearance="@style/TextAppearance.Cam.Caption"
                    android:textColor="@color/text_tertiary" />
                <LinearLayout
                    android:id="@+id/light_gear_rules"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout
                        android:id="@+id/light_gear_rows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:text="@string/mood_light_bands_title"
                        android:textAppearance="@style/TextAppearance.Cam.Body"
                        android:textColor="@color/text_primary" />
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/light_band_blend"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/mood_light_band_blend"
                        android:textAppearance="@style/TextAppearance.Cam.Body"
                        android:textColor="@color/text_primary" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/mood_light_band_blend_hint"
                        android:textAppearance="@style/TextAppearance.Cam.Caption"
                        android:textColor="@color/text_tertiary" />
                    <LinearLayout
                        android:id="@+id/light_band_rows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/light_band_add"
                        style="@style/Widget.Cam.RailSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:text="@string/mood_light_band_add" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_surface_card"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">
                <LinearLayout
                    android:id="@+id/light_devices"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
                <TextView
                    android:id="@+id/light_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:text="@string/mood_light_none"
                    android:textAppearance="@style/TextAppearance.Cam.Body"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
