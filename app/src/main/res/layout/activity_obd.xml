<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="16dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/title_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="16dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/obd_back"
            style="@style/Widget.Cam.IconButton"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:contentDescription="@string/action_back"
            app:icon="@drawable/ic_back" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="@string/obd_title"
            android:textAppearance="@style/TextAppearance.Cam.Title"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_surface_card"
        android:orientation="vertical"
        android:padding="12dp">
        <TextView
            android:id="@+id/obd_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:textAppearance="@style/TextAppearance.Cam.Caption"
            android:textColor="@color/text_secondary" />
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">
            <LinearLayout
                android:id="@+id/obd_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp" />
        </ScrollView>
        <!-- The buttons stay out of the title bar: the floating button sits there by default.
             And out of the list: it is rebuilt each round, which would swallow a tap -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:paddingStart="16dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/obd_connect"
                style="@style/Widget.Cam.RailSmall"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:text="@string/obd_connect" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/obd_scan"
                style="@style/Widget.Cam.RailSmall"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginStart="12dp"
                android:text="@string/obd_scan" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/obd_record"
                style="@style/Widget.Cam.RailSmall"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginStart="12dp"
                android:text="@string/obd_record" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/obd_live_window"
                style="@style/Widget.Cam.RailSmall"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginStart="12dp"
                android:text="@string/obd_live_show"
                android:visibility="gone" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/obd_read_codes"
                style="@style/Widget.Cam.RailSmall"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginStart="12dp"
                android:text="@string/obd_codes_read"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
