<?xml version="1.0" encoding="utf-8"?>
<!-- 列表里的一行：和设置行一样是一块圆角灰卡（7xDash 统一样式） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_pref_row_static"
    android:minHeight="72dp"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <View
        android:id="@+id/sticker_dot"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/sticker_dot"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/sticker_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Cam.Body"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/sticker_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Cam.Caption"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/sticker_action"
        style="@style/Widget.Cam.RailSmall"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:text="@string/sticker_connect" />
</LinearLayout>
